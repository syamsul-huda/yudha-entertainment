# Salin jadi server/.env lalu isi.

# PostgreSQL di NAS (server yang sama dengan Project Control Dashboard).
# Dari dalam Docker, JANGAN pakai "localhost" — isi IP LAN NAS, mis. 192.168.1.10.
# Database "yudha_entertainment" dibuat otomatis kalau belum ada.
DB_HOST=192.168.x.x
DB_PORT=5432
DB_NAME=yudha_entertainment
DB_USER=postgres
DB_PASSWORD=

PORT=3100

# Wajib, minimal 32 karakter acak. Buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=12h

# Admin pertama (dibuat sekali saat tabel admin masih kosong). Hapus password ini setelah login pertama.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAMA=Admin Yudha

# Berapa acara terkonfirmasi per hari sampai tanggal otomatis "penuh".
MAKS_ACARA_PER_HARI=1

# Isi "true" kalau diakses lewat Cloudflare Tunnel / reverse proxy.
TRUST_PROXY=

# Opsional: token Cloudflare Tunnel (lihat docker-compose.yml)
TUNNEL_TOKEN=
